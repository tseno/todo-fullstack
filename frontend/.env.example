# ローカル開発用の環境変数。frontend/.env.local としてコピーして使う
# （NEXT_PUBLIC_* はビルド時に埋め込まれる）

# Cognito Hosted UIのドメインとクライアントID
NEXT_PUBLIC_COGNITO_DOMAIN=todo-fullstack-201302613838.auth.ap-northeast-1.amazoncognito.com
NEXT_PUBLIC_COGNITO_CLIENT_ID=558ic139gocj8dbv2ba7b0rept

# ローカルのバックエンドAPI。本番（CloudFront配信）ではこの行を外すと
# 同一オリジン（/api）でバックエンドに繋がる
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
